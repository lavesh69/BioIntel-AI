# Local development defaults. Keep this file free of real secrets.
BIOINTEL_ENV=local
BIOINTEL_INTERNET_ENABLED=1
BIOINTEL_ALLOW_PUBLIC_HTTPS=1
BIOINTEL_OFFICIAL_HOSTS_ONLY=1
BIOINTEL_RESOLVE_DNS=1
BIOINTEL_MAX_DOWNLOAD_MB=250
BIOINTEL_NETWORK_TIMEOUT=30
BIOINTEL_NETWORK_RETRIES=2

# Local API can remain no-login when bound only to loopback.
BIOINTEL_API_KEY=
BIOINTEL_API_RATE_LIMIT=120
BIOINTEL_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
BIOINTEL_PRELOAD_MODELS=0
BIOINTEL_PRELOAD_MODEL_LIMIT=6

# Education OS Phase 17-22 local persistence and optional local media tools.
# Leave BIOINTEL_USER_DATA_DIR empty to use %LOCALAPPDATA%\BioIntelAI\UserData on Windows.
BIOINTEL_USER_DATA_DIR=
BIOINTEL_CONNECT_STORAGE=
BIOINTEL_FFMPEG=
BIOINTEL_FFPROBE=

# Credential-free offline Education lecture transcription. A blank model path uses
# models/education/faster-whisper-tiny bundled with the verified Windows release.
BIOINTEL_TRANSCRIPTION_PROVIDER=local_faster_whisper
BIOINTEL_TRANSCRIPTION_MODEL=
BIOINTEL_TRANSCRIPTION_COMPUTE_TYPE=int8
BIOINTEL_TRANSCRIPTION_CPU_THREADS=0
BIOINTEL_TRANSCRIPTION_BEAM_SIZE=3
# Public-internet calling is not considered verified until real TURN credentials and relay
# diagnostics pass. The default STUN value only supports peer-to-peer discovery.
BIOINTEL_CALL_STUN_URLS=stun:stun.l.google.com:19302
BIOINTEL_CALL_TURN_URL=
BIOINTEL_CALL_TURN_USERNAME=
BIOINTEL_CALL_TURN_CREDENTIAL=

# Education and Research Phases 23-30 safe local defaults.
BIOINTEL_DEPLOYMENT_PROFILE=local_desktop
BIOINTEL_PHASE30_OBSERVABILITY_SENSITIVE_CONTENT=0
BIOINTEL_PHASE30_IMPORT_MAX_MB=50
BIOINTEL_PHASE30_IMPORT_MAX_ROWS=100000
BIOINTEL_PHASE30_AGENT_PROVIDER=local
BIOINTEL_PHASE30_AGENT_MAX_DEPTH=4
BIOINTEL_PHASE30_AGENT_DEFAULT_TIMEOUT=120
BIOINTEL_PHASE30_WEBHOOK_REPLAY_TOLERANCE_SECONDS=300
BIOINTEL_PHASE30_PLUGIN_DEVELOPMENT_MODE=0

# BioIntel MCP is disabled until a scoped API key and explicit per-tool policies exist.
BIOINTEL_MCP_PRINCIPAL=
BIOINTEL_MCP_INSTITUTION=
BIOINTEL_MCP_API_KEY=

# Optional institution/cluster dependencies. Local desktop mode does not require these.
BIOINTEL_POSTGRES_DSN=
BIOINTEL_REDIS_URL=
BIOINTEL_S3_ENDPOINT_URL=
BIOINTEL_S3_BUCKET=
BIOINTEL_S3_REGION=
BIOINTEL_S3_ACCESS_KEY_REFERENCE=
BIOINTEL_S3_SECRET_KEY_REFERENCE=

# Optional standards-ready identity configuration; real provider validation is required.
BIOINTEL_OAUTH_ISSUER=
BIOINTEL_OAUTH_CLIENT_ID=
BIOINTEL_OAUTH_CLIENT_SECRET_REFERENCE=
BIOINTEL_OIDC_ISSUER=
BIOINTEL_SAML_METADATA_URL=

# Tenant selection for tenant-aware API requests.
BIOINTEL_DEFAULT_TENANT=default
# Registered clients can declare tenant_ids/default_tenant in BIOINTEL_API_CLIENTS_JSON.

# Production deployment template. Do not commit real credentials.
# BIOINTEL_ENV=production
# BIOINTEL_API_CLIENTS_JSON={"clients":[{"client_id":"operator","key":"REPLACE_WITH_SECRET_MANAGER_VALUE","role":"admin","tenant_ids":["default"]}]}
# BIOINTEL_TRUSTED_HOSTS=biointel.example.org,biointel-api.internal
# BIOINTEL_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/biointel
# BIOINTEL_REDIS_URL=redis://redis:6379/0
# BIOINTEL_OBJECT_STORAGE_ENDPOINT=http://minio:9000
# BIOINTEL_PERSISTENCE_BACKEND=postgres
# BIOINTEL_QUEUE_BACKEND=redis
# BIOINTEL_ARTIFACT_BACKEND=minio

# Step 52 proper live connections. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
OPENAI_STORE_RESPONSES=0
OPENAI_ALLOW_CUSTOM_BASE_URL=0
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=BioIntelAI
STRING_CALLER_IDENTITY=BioIntelAI
BIOINTEL_CONNECTED_TIMEOUT=30
BIOINTEL_CONNECTED_CONNECT_TIMEOUT=8
BIOINTEL_CONNECTED_RETRIES=3
BIOINTEL_CONNECTED_CACHE_TTL=86400
BIOINTEL_CONNECTED_MAX_RECORDS=25
BIOINTEL_CONNECTED_MAX_RESPONSE_MB=24
BIOINTEL_CONNECTED_MAX_REDIRECTS=3

# Step 122 local protein-design model assets. Paths are optional until the corresponding backend is used.
BIOINTEL_PROTEINMPNN_WEIGHTS=
BIOINTEL_RFDIFFUSION_WEIGHTS=
BIOINTEL_COLABFOLD_PARAMS=
BIOINTEL_FOLDX_HOME=
BIOINTEL_ROSETTA_DATABASE=
BIOINTEL_ENABLE_LEGACY_PROTEIN_TOOL_ARGS=0

# Shiro AI (local-first safe defaults)
SHIRO_ENABLED=true
SHIRO_DEFAULT_MODE=local
SHIRO_PROVIDER=local
SHIRO_CHAT_MODEL=grounded-extractive-v1
SHIRO_EMBEDDING_PROVIDER=local
SHIRO_EMBEDDING_MODEL=hash-multilingual-v1
SHIRO_EMBEDDING_DIMENSION=384
SHIRO_RERANKER_ENABLED=false
SHIRO_EXTERNAL_SEARCH_ENABLED=false
SHIRO_MAX_FILE_SIZE_MB=25
SHIRO_OCR_ENABLED=false
SHIRO_OCR_LANGUAGE=eng
SHIRO_OCR_MAX_PAGES=25
SHIRO_RETRIEVAL_TOP_K=6
SHIRO_CONTEXT_LIMIT=12000
SHIRO_PROJECT_ISOLATION=true
SHIRO_CHUNK_SIZE=1600
SHIRO_CHUNK_OVERLAP=160
SHIRO_ALLOW_MODEL_DOWNLOADS=false
SHIRO_OLLAMA_ENABLED=false
SHIRO_OLLAMA_BASE_URL=http://127.0.0.1:11434
SHIRO_OLLAMA_MODEL=gemma3:1b
SHIRO_GENERATION_TIMEOUT_SECONDS=60
# SHIRO_DATA_DIR=C:\BioIntelAI\UserData\shiro
