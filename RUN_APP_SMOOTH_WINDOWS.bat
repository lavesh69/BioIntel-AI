@echo off
setlocal EnableExtensions DisableDelayedExpansion
cd /d "%~dp0"
set "BIOINTEL_OPTIMIZED_RUNTIME=1"
set "BIOINTEL_THREADS=2"
if defined NUMBER_OF_PROCESSORS if %NUMBER_OF_PROCESSORS% GEQ 8 set "BIOINTEL_THREADS=4"
set "OMP_NUM_THREADS=%BIOINTEL_THREADS%"
set "OPENBLAS_NUM_THREADS=%BIOINTEL_THREADS%"
set "MKL_NUM_THREADS=%BIOINTEL_THREADS%"
set "NUMEXPR_MAX_THREADS=%BIOINTEL_THREADS%"
set "TOKENIZERS_PARALLELISM=false"
call "%~dp0RUN_APP_WINDOWS.bat"
exit /b %ERRORLEVEL%
