# BioIntel Education Full Local Production Upgrade R15
# Copy required keys into .env. Never store real secrets in this template.
BIOINTEL_DEPLOYMENT_PROFILE=local_desktop
BIOINTEL_USER_DATA_DIR=
BIOINTEL_FFMPEG=
BIOINTEL_FFPROBE=

# Bundled and credential-free. Blank model path selects models/education/faster-whisper-tiny.
BIOINTEL_TRANSCRIPTION_PROVIDER=local_faster_whisper
BIOINTEL_TRANSCRIPTION_MODEL=
BIOINTEL_TRANSCRIPTION_COMPUTE_TYPE=int8
BIOINTEL_TRANSCRIPTION_CPU_THREADS=0
BIOINTEL_TRANSCRIPTION_BEAM_SIZE=3

# Optional external deployment integrations. They intentionally remain configuration_required
# until real endpoints/credentials and provider-side diagnostic evidence exist.
BIOINTEL_CALL_TURN_URL=
BIOINTEL_CALL_TURN_USERNAME=
BIOINTEL_CALL_TURN_CREDENTIAL=
BIOINTEL_OIDC_ISSUER=
BIOINTEL_OAUTH_CLIENT_ID=
BIOINTEL_SMTP_HOST=
BIOINTEL_SMTP_SENDER=
BIOINTEL_POSTGRES_DSN=
BIOINTEL_REDIS_URL=
BIOINTEL_S3_BUCKET=