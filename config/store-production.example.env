# Public domain and TLS
BIOINTEL_PUBLIC_DOMAIN=biointel.example.com
BIOINTEL_PUBLIC_URL=https://biointel.example.com
BIOINTEL_CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost,https://biointel.example.com
BIOINTEL_TRUSTED_HOSTS=biointel.example.com,localhost,127.0.0.1,api,streamlit
BIOINTEL_OFFICIAL_HOSTS_ONLY=1
BIOINTEL_ENV=production
BIOINTEL_ENVIRONMENT=production

# Streamlit production sign-in. Generate hashes with:
# python scripts/create_ui_user.py --username admin
BIOINTEL_UI_AUTH_REQUIRED=1
BIOINTEL_UI_USERS_JSON={"admin":{"display_name":"Workspace Administrator","role":"admin","password_hash":"REPLACE_WITH_GENERATED_PBKDF2_HASH"}}

# API access. Mobile bootstrap/legal routes remain public; protected APIs require a key.
BIOINTEL_API_CLIENTS_JSON={"clients":[{"client_id":"mobile-operator","display_name":"Mobile operator","role":"operator","key":"REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS","quota_per_minute":120,"tenant_ids":["default"],"default_tenant":"default","tenant_role":"operator"}]}
BIOINTEL_DEFAULT_TENANT=default

# Infrastructure secrets
POSTGRES_DB=biointel
POSTGRES_USER=biointel
POSTGRES_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
MINIO_ROOT_USER=biointel
MINIO_ROOT_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Public support/legal metadata
BIOINTEL_SUPPORT_EMAIL=support@example.com
BIOINTEL_PRIVACY_EMAIL=privacy@example.com
